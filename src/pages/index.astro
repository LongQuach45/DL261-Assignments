---
import { ArrowRight, CodeXml, ExternalLink } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { aiSummaries, members, site } from "../data/site";
const base = import.meta.env.BASE_URL;
const at = (path: string) => `${base}/${path}`;
---
<BaseLayout title="Deep Learning and Its Applications" description="Course project hub for Group MobyDick in CO3133 Deep Learning and Its Applications." current="home">
  <section class="hero"><div class="shell hero-grid"><div><p class="eyebrow">CO3133 · Semester-261 · HCMUT</p><h1>Deep learning,<br /><em>made visible.</em></h1><p class="hero-copy">A course-project record by Group MobyDick: reproducible experiments, evidence-first analysis, and transparent project delivery.</p><div class="button-row"><a class="button" href="#assignments">Explore assignments <ArrowRight size={16} /></a><a class="button button-secondary" href={site.repository}>Repository <CodeXml size={16} /></a></div></div><aside class="hero-aside"><span>Group name</span><strong>{site.groupName}</strong><p>Deep Learning and Its Applications<br />Faculty of Computer Science and Engineering</p></aside></div></section>
  <section class="shell section"><div class="section-heading"><p class="eyebrow">Foundations</p><h2>Course and group</h2></div><div class="info-grid"><div class="surface"><dl class="detail-list"><div><dt>Group name</dt><dd>{site.groupName}</dd></div><div><dt>Institution</dt><dd>{site.institution}</dd></div><div><dt>Faculty</dt><dd>{site.faculty}</dd></div><div><dt>Course</dt><dd>{site.course} ({site.code})</dd></div><div><dt>Semester</dt><dd>{site.semester}</dd></div><div><dt>Instructor</dt><dd>{site.instructor}</dd></div></dl></div><div class="member-grid">{members.map((member) => <article class="member-card"><span>{member.id}</span><a href={member.github}>{member.name}</a><p>{member.role}</p></article>)}</div></div></section>
  <section class="shell section" id="assignments"><div class="section-heading"><p class="eyebrow">Course work</p><h2>Assignments, with evidence.</h2><p>Each page separates available artifacts from future deliverables, so the public record stays useful and truthful at every milestone.</p></div><div class="assignment-grid"><article class="assignment-card"><div class="card-top"><span class="number">01</span><span class="status status-complete">Implementation complete</span></div><h3>Foundations of Deep Learning Pipelines and Architectures</h3><p>Fashion-MNIST comparison of Linear, MLP, CNN, LSTM/GRU, and Transformer models.</p><div class="card-footer"><a class="text-link" href={at("assignments/a1.html")}>View results and resources <ArrowRight size={15} /></a></div></article><article class="assignment-card featured"><div class="card-top"><span class="number">02</span><span class="status status-active">Proposal + implementation</span></div><h3>Large-Scale Data and Specialized Tasks</h3><p>Food-101 fine-grained classification with a custom CNN and two-stage ResNet-50 transfer learning.</p><div class="card-footer"><a class="text-link" href={at("assignments/a2.html")}>View results and proposal <ArrowRight size={15} /></a></div></article><article class="assignment-card"><div class="card-top"><span class="number">03</span><span class="status status-planned">Planned</span></div><h3>Multimodal Deep Learning</h3><p>Proposal, paired-modal data, fusion experiments, and evaluation will be added when the assignment starts.</p><div class="card-footer"><a class="text-link" href={at("assignments/a3.html")}>View assignment record <ArrowRight size={15} /></a></div></article></div></section>
  <section class="shell section"><div class="section-heading"><p class="eyebrow">Transparency</p><h2>AI usage disclosure</h2><p>Concise public summaries are provided here; detailed, assignment-specific records remain in the repository.</p></div><div class="ai-grid">{aiSummaries.map((entry) => <article class="ai-card"><h3>{entry.assignment}</h3><p><strong>{entry.tool}.</strong> {entry.summary}</p><small>{entry.verification}</small><p><a class="text-link" href={entry.href}>Open detailed record <ExternalLink size={14} /></a></p></article>)}</div></section>
</BaseLayout>
