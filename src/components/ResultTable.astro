---
interface Props { caption: string; rows: Record<string, string>[]; columns: { key: string; label: string; format?: (value: string) => string }[]; }
const { caption, rows, columns } = Astro.props;
---
<div class="table-wrap"><table><caption>{caption}</caption><thead><tr>{columns.map((column) => <th scope="col">{column.label}</th>)}</tr></thead><tbody>{rows.map((row) => <tr>{columns.map((column) => <td>{column.format ? column.format(row[column.key]) : row[column.key]}</td>)}</tr>)}</tbody></table></div>
